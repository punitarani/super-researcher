# Copy this file to .env and fill in your own keys: cp .env.example .env
# .env is git-ignored: never commit real keys.
# One KEY=value per line; quotes are optional, and `#` starts a comment.
# The app reads this file on every run, so there's no need to restart after editing it.
# Without a search key, runs still plan and write their reports but find no new sources.

# Search providers (pick any; more providers = broader discovery)
SERP_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# Agent: pick Codex or Gemini from the top bar in the app.
# Codex needs no key here: install the Codex CLI and run `codex login` to use your ChatGPT plan.
# Optional: by default Codex picks the best model for your plan.
# CODEX_MODEL=

# Gemini agent
GEMINI_API_KEY=
# GOOGLE_API_KEY=        # accepted as an alias for GEMINI_API_KEY
# GEMINI_MODEL=gemini-flash-latest
